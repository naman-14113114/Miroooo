# TryMiro UK Environment Configuration Example
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# Whop Checkout API Configuration (Migrated from XPageDrop)
# Dedicated API key for TryMiro (do NOT use Buudy keys)
WHOP_API_KEY=your_trymiro_whop_api_key_here

# CJDropshipping Fulfillment API
# Dedicated CJ API credentials for TryMiro (do NOT use Buudy keys)
CJ_API_KEY=your_trymiro_cj_api_key_here

# Offline Conversions Secret (Bing Ads)
MIROOOO_BING_ADS_SECRET=your_miroooo_bing_ads_secret_here
