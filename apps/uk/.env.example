# TryMiro UK Environment Configuration Example
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# Optional read-only lookups for existing Whop order references
WHOP_API_KEY=your_trymiro_whop_api_key_here

# XPage orders (server only, separate from the public checkout handoff)
XPAGE_USER_TOKEN=
XPAGE_XSRF_TOKEN=
# Optional legacy XPage reference-to-carrier mappings as a JSON array
MIROOOO_LEGACY_TRACKING_ALIASES=

# CJDropshipping Fulfillment API
# Dedicated CJ API credentials for TryMiro (do NOT use Buudy keys)
CJ_API_KEY=your_trymiro_cj_api_key_here

# Optional CJ shop-order reader, for accounts using a separate order credential
CJ_ORDER_ACCESS_TOKEN=

# Offline Conversions Secret (Bing Ads)
MIROOOO_BING_ADS_SECRET=your_miroooo_bing_ads_secret_here
